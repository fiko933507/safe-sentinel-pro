{
  "name": "safe-sentinel-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "production:preflight": "node scripts/production-preflight.mjs",
    "railway:predeploy": "npm run production:preflight && npm run prisma:migrate:deploy",
    "railway:start": "npm run production:preflight && npm start",
    "smoke:local": "node scripts/local-smoke-test.mjs",
    "scam:sync": "node scripts/sync-global-scam-intelligence.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@solana/web3.js": "^1.98.4",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
